{
  "name": "latinos-frontdoor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "mkdir -p .next/types && next typegen && tsc --noEmit",
    "smoke:routes": "node ./scripts/route-smoke.mjs",
    "smoke:browser": "python3 ./scripts/browser-smoke.py",
    "smoke:prod": "pnpm build && node ./scripts/prod-smoke.mjs",
    "verify": "pnpm typecheck && pnpm smoke:prod"
  },
  "dependencies": {
    "next": "15.5.23",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.7.0"
}
